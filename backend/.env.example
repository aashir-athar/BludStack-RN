# BludStack Backend - Environment Variables
# Copy to .env and fill in your values

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Supabase (service role - NEVER expose this publicly) ────
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# For development: * (open)
# For production: your deployed frontend URL
ALLOWED_ORIGINS=*

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Geo-fencing ──────────────────────────────────────────────
# Seconds to wait before expanding to next radius ring
GEO_EXPANSION_DELAY_SECONDS=30

# ── Cron auth (REQUIRED in production) ───────────────────────
# Shared secret protecting the /api/cron/* endpoints. If unset, the cron
# endpoints FAIL CLOSED in production (return 401) and are open only in
# development. Generate a long random value (e.g. `openssl rand -hex 32`) and
# set it BOTH in your host env and in whatever scheduler calls the endpoints.
CRON_SECRET=

# ── Push notifications (optional) ────────────────────────────
# Expo access token for enhanced push security (expo-server-sdk). Optional -
# leave blank to send without an access token.
EXPO_ACCESS_TOKEN=

# ── Proxy ────────────────────────────────────────────────────
# Number of reverse-proxy hops in front of the app. Render/Railway/Vercel = 1.
TRUST_PROXY=1
