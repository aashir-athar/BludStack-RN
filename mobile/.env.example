# BludStack - mobile environment variables
# Copy this file to .env and fill in your values. Never commit your real .env.

# ============================================================
# BACKEND API (required)
# Your deployed Express API base URL, including the version prefix.
# ============================================================
EXPO_PUBLIC_API_URL=https://your-backend-url/api/v1

# ============================================================
# SUPABASE (required)
# From: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# Use the anon (public) key here, never the service_role key.
# ============================================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ============================================================
# EAS (Expo Application Services)
# From: https://expo.dev
# ============================================================
EAS_PROJECT_ID=your-eas-project-id-here

# ============================================================
# MAPS: no key needed. BludStack renders maps with MapLibre over free
# OpenStreetMap and CARTO tiles - there is no Google Maps dependency and no
# paid API key anywhere. The app is free to run.
# ============================================================
